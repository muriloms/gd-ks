{
  "name": "gd-ks",
  "version": "0.4.0-beta.2",
  "description": "Game Development Knowledge System — AI-powered, multi-engine framework for game development (Godot 4, Unity 6, Unreal Engine 5).",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "gd-ks": "./bin/gd-ks.js"
  },
  "scripts": {
    "start": "node bin/gd-ks.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:all": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=html --reports-dir=coverage node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:watch": "node --test --watch tests/unit/*.test.js",
    "validate:schemas": "node scripts/validate-all.js",
    "validate:agents": "node tools/validator/validator.js --type=agent",
    "validate:workflows": "node tools/validator/validator.js --type=workflow",
    "validate:modules": "node tools/validator/validator.js --type=module",
    "lint": "eslint . --max-warnings=0",
    "lint:md": "node scripts/lint-markdown.js",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "node scripts/prepare.js",
    "prepublishOnly": "npm run lint && npm run validate:schemas && npm run test:unit"
  },
  "keywords": [
    "game-development",
    "unreal-engine",
    "ue5",
    "godot",
    "godot-4",
    "unity",
    "unity-6",
    "ai-agents",
    "multi-agent",
    "game-design",
    "gdd",
    "scrum",
    "agile",
    "cursor",
    "windsurf",
    "claude",
    "llm",
    "workflow",
    "framework",
    "gamedev",
    "indie-game",
    "game-dev-tools",
    "re-g3x",
    "research"
  ],
  "author": "Murilo Moro",
  "contributors": [
    {
      "name": "RE-G3X",
      "url": "https://re-g3x.github.io"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muriloms/gd-ks.git"
  },
  "bugs": {
    "url": "https://github.com/muriloms/gd-ks/issues"
  },
  "homepage": "https://github.com/muriloms/gd-ks#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "tools/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.3.7",
    "js-yaml": "^4.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^9.15.0",
    "prettier": "^3.4.2"
  }
}
