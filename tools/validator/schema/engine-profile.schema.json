{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdks.dev/schemas/engine-profile.schema.json",
  "title": "GD-KS Engine Profile",
  "description": "Schema for engine-profile.yaml — describes the capabilities, idioms, and handoff requirements of a GD-KS engine module.",
  "type": "object",
  "required": ["schema_version", "engine", "paradigms", "agents_provided", "handoff_consumes"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "engine": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": { "type": "string", "minLength": 2 },
        "vendor": { "type": "string" },
        "version_range": { "type": "string" },
        "documentation_url": { "type": "string", "format": "uri" }
      }
    },
    "paradigms": {
      "type": "object",
      "required": ["primary_languages"],
      "additionalProperties": true,
      "properties": {
        "primary_languages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "secondary_languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "has_visual_scripting": { "type": "boolean" },
        "has_ecs": { "type": "boolean" },
        "has_gas": { "type": "boolean" },
        "rendering": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "supports_platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["pc", "console", "mobile", "vr", "web"]
          }
        },
        "multiplayer": {
          "type": "array",
          "items": { "type": "string" }
        },
        "animation_systems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "physics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "audio": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "agents_provided": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "workflows_provided": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "trigger"],
        "properties": {
          "id": { "type": "string" },
          "trigger": { "type": "string" },
          "agent": { "type": "string" }
        }
      }
    },
    "handoff_consumes": {
      "type": "object",
      "required": ["from_phase"],
      "properties": {
        "from_phase": {
          "type": "integer",
          "const": 3
        },
        "required_deliverables": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "planning_template_hints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "preferred_for_core_logic": { "type": "string" },
        "preferred_for_designer_tunables": { "type": "string" },
        "typical_folder_structure": {
          "type": "array",
          "items": { "type": "string" }
        },
        "story_implementation_note_template": { "type": "string" }
      }
    }
  }
}
